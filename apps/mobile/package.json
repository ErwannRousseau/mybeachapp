  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "main": "index.js",
  "name": "@mybeachapp/mobile",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clear": "rm -rf .expo .tamagui .turbo .cache node_modules/.cache ${TMPDIR:-/tmp}/haste-map-* ${TMPDIR:-/tmp}/metro-cache *.tsbuildinfo",
    "clear:start": "expo start --clear",
    "dev": "bun run ios",
    "dev:android": "expo run:android --device \"Medium_Phone_API_35\"",
    "dev:ios18": "expo run:ios --device \"iPhone 16\"",
    "ios": "expo run:ios --device \"iPhone 17 Pro\"",
    "ios:18": "expo run:ios --device \"iPhone 16\"",
    "native:prebuild": "expo prebuild --platform all",
    "native:prebuild:android": "expo prebuild --platform android",
    "native:prebuild:ios": "expo prebuild --platform ios",
    "open:android": "expo run:android --device \"Medium_Phone_API_35\" --no-bundler",
    "open:ios18": "expo run:ios --device \"iPhone 16\" --no-bundler",
    "start": "expo start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "version": "0.0.0"
}
