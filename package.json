{
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@mybeachapp/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "chrome-devtools-mcp": "^1.2.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "xcodebuildmcp": "^2.6.2"
  },
  "name": "my-beach-app",
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "clear": "turbo run clear && rm -rf .turbo ${TMPDIR:-/tmp}/haste-map-* ${TMPDIR:-/tmp}/metro-cache && (watchman watch-del-all || true)",
    "clear:deps": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && bun pm cache rm && bun install",
    "dev": "turbo run dev --ui=tui",
    "dev:android": "bun run --cwd apps/mobile dev:android",
    "dev:ios18": "bun run --cwd apps/mobile dev:ios18",
    "native:prebuild": "bun run --cwd apps/mobile native:prebuild",
    "open:android": "bun run --cwd apps/mobile open:android",
    "open:ios18": "bun run --cwd apps/mobile open:ios18",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "workspaces": {
    "catalog": {
      "@better-auth/expo": "^1.6.11",
      "@convex-dev/better-auth": "^0.12.2",
      "@types/node": "^22.19.18",
      "better-auth": "^1.6.11",
      "convex": "^1.28.0",
      "kysely": "0.28.17",
      "react-hook-form": "^7.75.0",
      "typescript": "6.0.3",
      "vitest": "^4.1.5",
      "zod": "^4.4.3"
    },
    "packages": [
      "apps/*",
      "packages/*"
    ]
  }
}
