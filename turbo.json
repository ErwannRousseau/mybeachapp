{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": [
    "CONVEX_DEPLOY_KEY",
    "CONVEX_DEPLOYMENT",
    "CONVEX_SITE_URL",
    "CONVEX_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".expo/**", "*.tsbuildinfo"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:fix": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clear": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo", "dist/**/*.tsbuildinfo"]
    }
  }
}
