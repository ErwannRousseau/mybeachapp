{
  "exports": {
    "./typescript/base": "./typescript/base.json"
  },
  "name": "@mybeach/config",
  "private": true,
  "scripts": {
    "build": "mkdir -p dist && cp typescript/base.json dist/tsconfig-base.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "bun test ./typescript/base.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
