{
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mybeachapp/config": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    "./auth/constants": {
      "types": "./dist/auth/constants.d.ts",
      "default": "./src/auth/constants.ts"
    },
    "./auth/schemas": {
      "types": "./dist/auth/schemas.d.ts",
      "default": "./src/auth/schemas.ts"
    },
    "./auth/types": {
      "types": "./dist/auth/types.d.ts",
      "default": "./src/auth/types.ts"
    },
    "./activities/constants": {
      "types": "./dist/activities/constants.d.ts",
      "default": "./src/activities/constants.ts"
    },
    "./activities/schemas": {
      "types": "./dist/activities/schemas.d.ts",
      "default": "./src/activities/schemas.ts"
    },
    "./activities/types": {
      "types": "./dist/activities/types.d.ts",
      "default": "./src/activities/types.ts"
    },
    "./activities/validators": {
      "types": "./dist/activities/validators.d.ts",
      "default": "./src/activities/validators.ts"
    },
    "./participations/constants": {
      "types": "./dist/participations/constants.d.ts",
      "default": "./src/participations/constants.ts"
    },
    "./participations/schemas": {
      "types": "./dist/participations/schemas.d.ts",
      "default": "./src/participations/schemas.ts"
    },
    "./participations/types": {
      "types": "./dist/participations/types.d.ts",
      "default": "./src/participations/types.ts"
    },
    "./participations/validators": {
      "types": "./dist/participations/validators.d.ts",
      "default": "./src/participations/validators.ts"
    },
    "./users/constants": {
      "types": "./dist/users/constants.d.ts",
      "default": "./src/users/constants.ts"
    },
    "./users/schemas": {
      "types": "./dist/users/schemas.d.ts",
      "default": "./src/users/schemas.ts"
    },
    "./users/types": {
      "types": "./dist/users/types.d.ts",
      "default": "./src/users/types.ts"
    },
    "./users/validators": {
      "types": "./dist/users/validators.d.ts",
      "default": "./src/users/validators.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "name": "@mybeachapp/shared",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rm -rf .turbo dist *.tsbuildinfo",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "tsc   --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
